// Prisma schema — source of truth for the database structure.
// Human-readable companion: docs/database.md (keep both in sync on review).
//
// Prisma ORM is pinned to the 5.x line (classic "prisma-client-js" generator)
// rather than the newly released 7.x — see docs/adr/0008-prisma-version-pin.md
// for why: 7.x's new generator emits ESM TypeScript source with explicit `.ts`
// extension imports and requires an explicit driver-adapter object instead of a
// connection-string, which is incompatible with this monolith's plain
// CommonJS/tsc NestJS build without introducing a bundler. This is a deviation
// from no specific prior document (ADR 0003 named Prisma but not a major
// version), recorded per the standing instruction to document any deviation.
//
// IMPORTANT — things Prisma cannot express that are handled outside this file:
//   - PostgreSQL Row-Level Security policies (tenant isolation defense-in-depth)
//     and the `app_user` role are created in a hand-written SQL migration
//     (prisma/migrations/.../migration.sql) and documented in
//     docs/database.md#5-row-level-security. Prisma has no schema syntax for RLS.
//   - Email case-insensitivity: docs/database.md's raw SQL used Postgres `citext`.
//     This schema uses plain `String` and normalizes email to lowercase at the
//     application layer instead, to avoid depending on a Prisma preview feature
//     for a non-essential convenience. See docs/database.md's Prisma
//     implementation notes.
//   - Polymorphic references (audit_logs.actor/subject, files.owner) are plain
//     columns, not Prisma relations — Prisma has no polymorphic-association
//     syntax. Referential integrity for these is enforced at the service layer.
//   - Two-role connection split (migration/owner vs restricted runtime `app_user`):
//     this schema's `url = env("DATABASE_URL")` is the privileged connection used
//     by the Prisma CLI (migrate/seed). apps/api's PrismaService overrides the
//     connection at runtime to the restricted `API_DATABASE_URL` via the
//     `datasources.db.url` constructor option — see apps/api/src/database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// ACTIVE: normal operation.
// TRIAL: pre-paid-conversion trial — operationally equivalent to ACTIVE for
//   authentication/access purposes, distinct only for billing/reporting.
// SUSPENDED: temporarily blocked (billing issue, policy violation) — every
//   user/parent of this school is blocked from login and refresh regardless
//   of their own account status; reversible by a platform admin.
// INACTIVE: deliberately deactivated (school closed, contract ended) — same
//   authentication effect as SUSPENDED, distinguished for reporting/audit
//   clarity. See docs/security.md#3-school-status.
enum SchoolStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  INACTIVE
}

// ACTIVE: can authenticate normally.
// INVITED: account created by a school admin but the person has not yet set
//   a password / completed onboarding — cannot authenticate until ACTIVE.
//   (No invite-acceptance flow exists yet in Phase 1 Step 1; the state exists
//   so account creation doesn't have to force an immediate password.)
// SUSPENDED: temporarily blocked by a school/platform admin (e.g. policy
//   violation, pending investigation) — cannot authenticate or refresh an
//   existing session; reversible.
// DISABLED: permanently deactivated (e.g. offboarded staff, closed account)
//   — same authentication effect as SUSPENDED, distinguished for reporting/
//   audit clarity, not treated as reversible by ordinary admin action.
// See docs/security.md#7-account-states.
enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

// ACTIVE: in normal service.
// INACTIVE: temporarily withdrawn from service by a school (e.g. off-season,
//   awaiting a spare part) — reversible via a normal status update.
// MAINTENANCE: temporarily out of service for repair/inspection — reversible.
// RETIRED: permanently decommissioned — the terminal state, set only via the
//   dedicated archive endpoint (never a plain status update), mirroring how
//   Student.status's INACTIVE-on-archive works. See docs/security.md.
enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

// Renamed from the Phase 0 placeholder values (GPS/CAMERA/EDGE_AI_BOX) to
// match the names actually specified when this module was built (Phase 1
// Step 3) — no rows existed under the old names, so this is a same-migration
// rename, not a data migration. CAMERA_CONTROLLER (a Phase 2 device type) is
// deliberately not added yet — adding an enum value for a device type this
// phase does nothing with would be exactly the kind of speculative field the
// project's anti-over-engineering principle rules out; it's cheap to add
// later, in the same migration that actually starts using it.
enum DeviceType {
  GPS_TRACKER
  EDGE_COMPUTER
  NETWORK_GATEWAY
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  FAULTY
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum Shift {
  MORNING_PICKUP
  AFTERNOON_DROP
  CUSTOM
}

// Which way a route physically runs — distinct from Shift (WHEN it runs):
// a school's morning route is virtually always HOME_TO_SCHOOL and its
// afternoon route SCHOOL_TO_HOME, but the two are independent facts (a
// CUSTOM-shift activity route could run either direction), so both fields
// are kept rather than inferring one from the other. See docs/database.md.
enum RouteDirection {
  HOME_TO_SCHOOL
  SCHOOL_TO_HOME
}

// ACTIVE: in current use, can be referenced by new Trips (once Trips exist).
// INACTIVE: temporarily not run (e.g. seasonal) — reversible via a normal
//   status update.
// ARCHIVED: terminal — set only via POST /routes/:id/archive, never a plain
//   status update, mirroring Bus.status's RETIRED. Never physically deleted:
//   a Trip may reference this route historically once Trips exist, and an
//   archived route must remain resolvable for that history.
enum RouteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Whether a stop is used for picking students up, dropping them off, or
// both — a HOME_TO_SCHOOL route's stops are typically PICKUP-only and a
// SCHOOL_TO_HOME route's DROPOFF-only, but modeled explicitly rather than
// inferred from the parent route's direction, since a real route can have
// exceptions (e.g. a stop used only for a subset of students either way).
enum StopMode {
  PICKUP
  DROPOFF
  BOTH
}

enum RouteStopStatus {
  ACTIVE
  INACTIVE
}

// SCHEDULED: created with a full bus/driver/attendant assignment, not yet
//   confirmed ready. Reversible to CANCELLED/NO_SHOW.
// READY: staff has explicitly re-confirmed the route/bus/driver/attendant
//   are still operational right now (re-checked at this transition, not
//   just at creation) — the mandatory checkpoint before a trip can start.
// IN_PROGRESS: started (`POST /trips/:id/start`) — `startedAt` set.
// COMPLETED: ended (`POST /trips/:id/complete`) — `endedAt` set. Terminal.
// CANCELLED: called off before or during execution, with a required reason
//   (`cancellationReason`). Terminal. Never a physical delete — see
//   docs/database.md's Trip section.
// NO_SHOW: reached its scheduled time without ever starting (crew/bus
//   failed to show), distinct from CANCELLED (a decided-in-advance
//   non-run) — only reachable from SCHEDULED/READY, never once IN_PROGRESS.
//   Terminal, reason required (reuses `cancellationReason`).
// See docs/adr/0012-trip-stop-snapshot-and-lifecycle.md for the full
// transition graph.
enum TripStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// This is Step 6 Attendance's field, not read or written by anything in
// Phase 1 Step 5 — kept from the Phase 0 scaffold for the future attendance
// module to use, deliberately untouched here. See TripStudent.membershipStatus
// for the Step 5 concept ("is this student even supposed to be on this
// trip"), which is a different question from this one ("what happened to
// them during it").
enum TripStudentStatus {
  EXPECTED
  BOARDING_PENDING
  BOARDED
  ABSENT
  DROPPED_OFF
  ARRIVED_AT_SCHOOL
}

// Manifest membership — Step 5's concept, distinct from TripStudentStatus
// (Step 6 attendance) above. PLANNED: added to the manifest, trip not yet
// started. ACTIVE: the trip has started (`POST /trips/:id/start` bulk-
// promotes every PLANNED entry) — this is the confirmed roster for the run
// actually happening. REMOVED: soft-removed from the manifest (never hard-
// deleted, for audit) — excluded from the default manifest view.
enum MembershipStatus {
  PLANNED
  ACTIVE
  REMOVED
}

enum AttendanceEventType {
  BOARDING_CONFIRMED
  MARKED_ABSENT
  DROPPED_OFF
  ARRIVED_AT_SCHOOL
  STATUS_CORRECTED
}

enum AttendanceEventSource {
  ATTENDANT_APP
  RFID
  QR
  CV
  SYSTEM
}

enum RecipientType {
  USER
  PARENT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

// Phase 1 Step 9: the controlled notification-producing event taxonomy.
// Deliberately narrower than the full internal DomainEvent union
// (apps/api/src/common/events/domain-event.types.ts) — TRIP_STARTED/
// TRIP_COMPLETED are published internally for future consumers but create
// no Notification row yet (neither the parent- nor staff-facing audience
// list calls for one), so they're not part of this DB enum at all. See
// docs/adr/0016-notifications-and-alerts.md.
enum NotificationEventType {
  CHILD_BOARDED
  CHILD_DROPPED_OFF
  TRIP_CANCELLED
  TRIP_NO_SHOW
  GPS_STALE
  GPS_OFFLINE
}

// Per-channel delivery outcome — distinct from a "logical notification"
// existing at all (see Notification/NotificationDelivery below).
// NOT_CONFIGURED is a deliberately distinct terminal state from FAILED: it
// means no real provider credential exists for this channel at all, not
// that a real delivery attempt failed. See docs/adr/0016.
enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  NOT_CONFIGURED
}

enum ActorType {
  USER
  PARENT
  SYSTEM
}

// Which identity table a token/session belongs to. Deliberately distinct
// from ActorType (audit_logs) even though the values overlap conceptually —
// this one has no SYSTEM case and exists specifically to keep the
// staff/parent authentication audience boundary structural, not just a role
// check. See docs/adr/0004-auth-strategy.md and docs/security.md.
enum AuthPrincipalType {
  STAFF
  PARENT
}

// Why a refresh token stopped being valid — kept for audit/forensics.
enum TokenRevokeReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_CHANGED
  ACCOUNT_SUSPENDED
  EXPIRED_CLEANUP
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model School {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  status       SchoolStatus @default(ACTIVE)
  address      Json?
  contactEmail String       @map("contact_email")
  contactPhone String?      @map("contact_phone")
  timezone     String       @default("Asia/Kolkata")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  users                  User[]
  roles                  Role[]
  students               Student[]
  parents                Parent[]
  parentStudents         ParentStudent[]
  buses                  Bus[]
  busDevices             BusDevice[]
  drivers                Driver[]
  attendants             Attendant[]
  routes                 Route[]
  routeStops             RouteStop[]
  trips                  Trip[]
  tripStops              TripStop[]
  tripStudents           TripStudent[]
  attendanceEvents       AttendanceEvent[]
  gpsPoints              GpsPoint[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  auditLogs              AuditLog[]
  files                  File[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  invitations            Invitation[]

  @@map("schools")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String        @id @default(uuid())
  schoolId           String        @map("school_id")
  email              String
  phone              String?
  // Nullable: an invited-but-not-yet-activated user (status INVITED) has no
  // password until they accept their invitation — see the Invitation model
  // and docs/security.md#6-invitation-flow. A user can never authenticate
  // while this is null, because login/refresh both require status ACTIVE,
  // which is only ever set once a password has also been set.
  passwordHash       String?       @map("password_hash")
  fullName           String        @map("full_name")
  status             AccountStatus @default(ACTIVE)
  mfaEnabled         Boolean       @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?       @map("mfa_secret_encrypted")
  lastLoginAt        DateTime?     @map("last_login_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  school                   School            @relation(fields: [schoolId], references: [id])
  userRoles                UserRole[]
  driverProfile            Driver?
  attendantProfile         Attendant?
  verifiedRelationships    ParentStudent[]   @relation("ParentStudentVerifiedBy")
  recordedAttendanceEvents AttendanceEvent[] @relation("AttendanceEventRecordedBy")
  createdFiles             File[]            @relation("FileCreatedBy")
  invitationsSent          Invitation[]      @relation("InvitationInvitedBy")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  schoolId  String?  @map("school_id")
  key       String
  name      String
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  school          School?          @relation(fields: [schoolId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String
  category    String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Students / Parents
// ---------------------------------------------------------------------------

model Student {
  id              String        @id @default(uuid())
  schoolId        String        @map("school_id")
  admissionNumber String        @map("admission_number")
  fullName        String        @map("full_name")
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  grade           String?
  section         String?
  photoFileId     String?       @map("photo_file_id")
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  school         School          @relation(fields: [schoolId], references: [id])
  photo          File?           @relation("StudentPhoto", fields: [photoFileId], references: [id])
  parentStudents ParentStudent[]
  tripStudents   TripStudent[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@map("students")
}

model Parent {
  id           String        @id @default(uuid())
  schoolId     String        @map("school_id")
  email        String?
  phone        String        @map("phone")
  passwordHash String?       @map("password_hash")
  fullName     String        @map("full_name")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  school         School          @relation(fields: [schoolId], references: [id])
  parentStudents ParentStudent[]

  @@unique([schoolId, phone])
  @@map("parents")
}

model ParentStudent {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  parentId     String    @map("parent_id")
  studentId    String    @map("student_id")
  relationship String    @default("GUARDIAN")
  verified     Boolean   @default(false)
  verifiedBy   String?   @map("verified_by")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  school   School  @relation(fields: [schoolId], references: [id])
  parent   Parent  @relation(fields: [parentId], references: [id])
  student  Student @relation(fields: [studentId], references: [id])
  verifier User?   @relation("ParentStudentVerifiedBy", fields: [verifiedBy], references: [id])

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("parent_students")
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Bus {
  id                 String    @id @default(uuid())
  schoolId           String    @map("school_id")
  // Internal/operational identifier (e.g. "Bus 7") — distinct from the legal
  // registration number; optional since a school may not assign one, but
  // unique per school when it is set (Postgres treats each NULL as distinct
  // in a unique index, so multiple buses may share "no fleet number yet").
  fleetNumber        String?   @map("fleet_number")
  registrationNumber String    @map("registration_number")
  capacity           Int
  make               String?
  model              String?
  manufactureYear    Int?      @map("manufacture_year")
  status             BusStatus @default(ACTIVE)
  permitExpiry       DateTime? @map("permit_expiry") @db.Date
  insuranceExpiry    DateTime? @map("insurance_expiry") @db.Date
  fitnessExpiry      DateTime? @map("fitness_expiry") @db.Date
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  school    School      @relation(fields: [schoolId], references: [id])
  devices   BusDevice[]
  trips     Trip[]
  gpsPoints GpsPoint[]

  @@unique([schoolId, registrationNumber])
  @@unique([schoolId, fleetNumber])
  @@map("buses")
}

model BusDevice {
  id               String       @id @default(uuid())
  schoolId         String       @map("school_id")
  busId            String       @map("bus_id")
  deviceType       DeviceType   @map("device_type")
  externalDeviceId String       @map("external_device_id")
  firmwareVersion  String?      @map("firmware_version")
  // Device-specific configuration (e.g. reporting interval), distinct from
  // lastHealth (a telemetry-derived snapshot no ingestion pipeline writes to
  // yet — see docs/roadmap.md).
  metadata         Json?
  status           DeviceStatus @default(ACTIVE)
  // Phase 1 Step 7's minimal, real device credential: an opaque bearer
  // token whose SHA-256 hash is stored here, following the exact same
  // generate/hash pattern as refresh/reset/invitation tokens
  // (TokenService.generateOpaqueToken) — never a plaintext secret at rest.
  // NULL until a staff member explicitly issues one via
  // `POST /devices/:id/credential`; a device with no credential set cannot
  // authenticate to the GPS ingestion endpoint at all. See
  // docs/security.md#5.1-device-security and docs/adr/0014.
  credentialHash   String?      @map("credential_hash")
  credentialSetAt  DateTime?    @map("credential_set_at")
  lastSeenAt       DateTime?    @map("last_seen_at")
  lastHealth       Json?        @map("last_health")
  installedAt      DateTime?    @map("installed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id])
  bus       Bus        @relation(fields: [busId], references: [id])
  gpsPoints GpsPoint[]

  @@unique([deviceType, externalDeviceId])
  @@unique([credentialHash])
  @@index([busId])
  @@map("bus_devices")
}

model Driver {
  id            String       @id @default(uuid())
  schoolId      String       @map("school_id")
  userId        String       @unique @map("user_id")
  licenseNumber String       @map("license_number")
  licenseExpiry DateTime?    @map("license_expiry") @db.Date
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  trips  Trip[]

  @@unique([schoolId, licenseNumber])
  @@map("drivers")
}

model Attendant {
  id        String       @id @default(uuid())
  schoolId  String       @map("school_id")
  userId    String       @unique @map("user_id")
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  trips  Trip[]

  @@map("attendants")
}

// ---------------------------------------------------------------------------
// Routes / Stops
// ---------------------------------------------------------------------------

// No `busId`/`driverId`/`attendantId` field — a Route is a reusable planned
// path, never bound to a specific vehicle or crew. That binding is the
// future Trip model's job (bus/driver/attendant + serviceDate + shift),
// which already exists in this schema (see below) precisely so it can be
// the one place operational assignment happens. See docs/database.md's
// Route-vs-Trip note. (A `defaultBusId` field from the Phase 0 scaffold was
// removed here — it modeled exactly the permanent bus↔route binding this
// phase's design explicitly rules out.)
model Route {
  id          String         @id @default(uuid())
  schoolId    String         @map("school_id")
  // Short internal reference (e.g. "R-01") — optional, distinct from `name`,
  // same optional-unique-per-school pattern as Bus.fleetNumber.
  code        String?
  name        String
  direction   RouteDirection
  shift       Shift
  status      RouteStatus    @default(ACTIVE)
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  school School      @relation(fields: [schoolId], references: [id])
  stops  RouteStop[]
  trips  Trip[]

  @@unique([schoolId, code])
  @@map("routes")
}

// Route-owned stops (not a separate reusable "physical stop" entity) — see
// docs/database.md's Route↔Stop note for why the simpler model is
// sufficient for MVP and what the tradeoff is if a school reuses the same
// physical location across routes.
model RouteStop {
  id                    String          @id @default(uuid())
  schoolId              String          @map("school_id")
  routeId               String          @map("route_id")
  sequenceNo            Int             @map("sequence_no")
  name                  String
  address               String?
  latitude              Float
  longitude             Float
  // Offset from trip start, not an absolute time — a Route is a template
  // with no start time of its own; an absolute ETA only exists once a Trip
  // (which has a serviceDate/start time) exists.
  expectedOffsetMinutes Int             @map("expected_offset_minutes")
  radiusMeters          Int             @default(150) @map("radius_meters")
  mode                  StopMode        @default(BOTH)
  status                RouteStopStatus @default(ACTIVE)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id])
  route     Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  tripStops TripStop[]

  @@unique([routeId, sequenceNo])
  @@map("route_stops")
}

// ---------------------------------------------------------------------------
// Trips / Attendance
// ---------------------------------------------------------------------------

// A Trip is one scheduled/actual EXECUTION of a Route — never the Route
// itself. `busId`/`driverId` are required (a trip is only ever created with
// both already assigned; there is no lesser "draft" trip without them in
// this design — see the ADR); `attendantId` stays optional, matching real
// operations where not every run carries one. `scheduledStartTime`/
// `scheduledEndTime` are validated "HH:mm" wall-clock strings, deliberately
// NOT a DateTime/timestamptz — see the ADR for why storing them as an
// already-converted UTC instant would risk exactly the timezone bug this
// phase was told to avoid. `startedAt`/`endedAt` ARE real `DateTime`
// instants, because they record a single moment that actually happened,
// which is unambiguous in UTC. `cancellationReason` is used for both
// CANCELLED and NO_SHOW (the same "why didn't this run as planned" fact).
model Trip {
  id                 String     @id @default(uuid())
  schoolId           String     @map("school_id")
  routeId            String     @map("route_id")
  busId              String     @map("bus_id")
  driverId           String     @map("driver_id")
  attendantId        String?    @map("attendant_id")
  serviceDate        DateTime   @map("service_date") @db.Date
  shift              Shift
  scheduledStartTime String     @map("scheduled_start_time")
  scheduledEndTime   String     @map("scheduled_end_time")
  status             TripStatus @default(SCHEDULED)
  startedAt          DateTime?  @map("started_at")
  endedAt            DateTime?  @map("ended_at")
  cancellationReason String?    @map("cancellation_reason")
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school           School            @relation(fields: [schoolId], references: [id])
  route            Route             @relation(fields: [routeId], references: [id])
  bus              Bus               @relation(fields: [busId], references: [id])
  driver           Driver            @relation(fields: [driverId], references: [id])
  attendant        Attendant?        @relation(fields: [attendantId], references: [id])
  tripStops        TripStop[]
  tripStudents     TripStudent[]
  attendanceEvents AttendanceEvent[]
  gpsPoints        GpsPoint[]

  @@unique([routeId, serviceDate, shift])
  @@index([schoolId, serviceDate])
  @@index([busId, serviceDate])
  @@index([driverId, serviceDate])
  @@index([attendantId, serviceDate])
  @@map("trips")
}

// An immutable snapshot of the route's active stops at the moment the Trip
// was created — never edited afterward. Exists specifically so a later edit
// to the live Route/RouteStop can never silently change what an existing
// Trip's plan was. `sourceRouteStopId` is kept only for traceability
// ("which live stop did this come from") and goes null if that RouteStop is
// ever deleted — the snapshot itself is unaffected either way. See
// docs/adr/0012-trip-stop-snapshot-and-lifecycle.md.
model TripStop {
  id                    String   @id @default(uuid())
  schoolId              String   @map("school_id")
  tripId                String   @map("trip_id")
  sourceRouteStopId     String?  @map("source_route_stop_id")
  sequenceNo            Int      @map("sequence_no")
  name                  String
  address               String?
  latitude              Float
  longitude             Float
  expectedOffsetMinutes Int      @map("expected_offset_minutes")
  mode                  StopMode
  createdAt             DateTime @default(now()) @map("created_at")

  school           School            @relation(fields: [schoolId], references: [id])
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceRouteStop  RouteStop?        @relation(fields: [sourceRouteStopId], references: [id], onDelete: SetNull)
  pickupStudents   TripStudent[]     @relation("TripStudentPickup")
  dropoffStudents  TripStudent[]     @relation("TripStudentDropoff")
  attendanceEvents AttendanceEvent[]

  @@unique([tripId, sequenceNo])
  @@index([schoolId])
  @@map("trip_stops")
}

// Explicit trip <-> student membership — a student never inherits a trip
// merely by belonging to its route. `pickupTripStopId`/`dropoffTripStopId`
// reference this Trip's OWN `TripStop` rows (never a live `RouteStop`, and
// never another trip's stop — enforced in the service layer since a bare FK
// can't express "must belong to this specific trip"); either may be null,
// meaning "the school itself" (the route's implicit terminus, which isn't
// modeled as a stop) — see docs/api.md's trips section. `membershipStatus`
// is the Step 5 concept ("is this student on the manifest"), never
// `currentStatus` above (Step 6 attendance's concept).
model TripStudent {
  id                String            @id @default(uuid())
  schoolId          String            @map("school_id")
  tripId            String            @map("trip_id")
  studentId         String            @map("student_id")
  pickupTripStopId  String?           @map("pickup_trip_stop_id")
  dropoffTripStopId String?           @map("dropoff_trip_stop_id")
  membershipStatus  MembershipStatus  @default(PLANNED) @map("membership_status")
  notes             String?
  // currentStatus/boardedAt/droppedOffAt are a derived, denormalized
  // projection for fast reads (the manifest list, one query, no N+1) — only
  // ever written by AttendanceService in response to an AttendanceEvent
  // insert, never directly by TripStudentsService. Same rule already
  // documented for currentStatus in docs/database.md, now actually wired up
  // in Phase 1 Step 6. Stop names for these are the existing
  // pickup/dropoff fields above — boarding/drop-off always occur at the
  // student's own planned stop, so no separate stop columns are needed here.
  currentStatus     TripStudentStatus @default(EXPECTED) @map("current_status")
  boardedAt         DateTime?         @map("boarded_at")
  droppedOffAt      DateTime?         @map("dropped_off_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  school           School            @relation(fields: [schoolId], references: [id])
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id])
  pickupTripStop   TripStop?         @relation("TripStudentPickup", fields: [pickupTripStopId], references: [id], onDelete: SetNull)
  dropoffTripStop  TripStop?         @relation("TripStudentDropoff", fields: [dropoffTripStopId], references: [id], onDelete: SetNull)
  attendanceEvents AttendanceEvent[]

  @@unique([tripId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("trip_students")
}

// Actual boarding/drop-off/absence events — never confused with
// TripStudent.membershipStatus (planned manifest membership, Step 5) or
// TripStudent.currentStatus (the derived projection this model feeds).
// Immutable once written: a correction is a NEW row with `correctsEventId`
// pointing at the event it corrects, never an update to the original — see
// docs/adr/0013-attendance-event-model.md.
model AttendanceEvent {
  id              String                @id @default(uuid())
  schoolId        String                @map("school_id")
  tripId          String                @map("trip_id")
  tripStudentId   String                @map("trip_student_id")
  // The stop this event is associated with — always derived server-side
  // from the TripStudent's own pickup/dropoff assignment, never a
  // client-supplied stop id (see TripsAttendanceService). Null means "the
  // school itself", same convention as TripStudent's own stop fields.
  tripStopId      String?               @map("trip_stop_id")
  eventType       AttendanceEventType   @map("event_type")
  // MANUAL, in this phase's vocabulary, is represented by the existing
  // ATTENDANT_APP value (Phase 0's scaffold) — no new enum was introduced
  // for the same concept under a different name. RFID/QR/CV/SYSTEM remain
  // reserved and unused, same as Phase 0 left them.
  source          AttendanceEventSource @default(ATTENDANT_APP)
  recordedBy      String?               @map("recorded_by")
  occurredAt      DateTime              @default(now()) @map("occurred_at")
  // Set only on a correction event — the event this one supersedes for
  // TripStudent.currentStatus purposes. Never set on a normal event.
  correctsEventId String?               @map("corrects_event_id")
  notes           String?
  latitude        Float?
  longitude       Float?
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  school        School            @relation(fields: [schoolId], references: [id])
  trip          Trip              @relation(fields: [tripId], references: [id])
  tripStudent   TripStudent       @relation(fields: [tripStudentId], references: [id])
  tripStop      TripStop?         @relation(fields: [tripStopId], references: [id])
  recorder      User?             @relation("AttendanceEventRecordedBy", fields: [recordedBy], references: [id])
  correctsEvent AttendanceEvent?  @relation("AttendanceEventCorrection", fields: [correctsEventId], references: [id])
  corrections   AttendanceEvent[] @relation("AttendanceEventCorrection")

  @@index([tripId, occurredAt])
  @@index([tripStudentId, occurredAt])
  @@index([schoolId])
  @@map("attendance_events")
}

// ---------------------------------------------------------------------------
// GPS / Telemetry
// ---------------------------------------------------------------------------

// Historical/raw telemetry — one row per accepted device fix (Phase 1 Step
// 7). Deliberately NOT the read path for "where is this bus right now": that
// is Redis (see docs/adr/0014-gps-telemetry-and-realtime-tracking.md) with a
// fallback to `ORDER BY deviceTime DESC LIMIT 1` on this table after a cold
// start. `deviceTime` is the device's own clock ("recordedAt" in the API);
// `receivedAt` is server-controlled and never client-suppliable. `accuracyM`
// was added this phase (the model's minimum viable field set already
// included lat/lng/speed/heading/device/bus/school/timestamps from Phase 0;
// accuracy is genuinely useful operational GPS data, so it earns its column
// too — ignitionOn/networkState from the Phase 0 scaffold remain unused by
// any ingestion path this phase, same "don't wire a field just because a
// column exists" discipline as attendance's TripStudentStatus enum values).
// `@@unique([deviceId, deviceTime])` is the retry-safe dedup key: a device
// resending the same fix (same clock reading) is a no-op, not a duplicate
// row — no client-supplied event ID was worth adding for polling-interval
// GPS trackers where device+timestamp is already a natural idempotency key.
model GpsPoint {
  id           BigInt   @id @default(autoincrement())
  schoolId     String   @map("school_id")
  busId        String   @map("bus_id")
  deviceId     String   @map("device_id")
  tripId       String?  @map("trip_id")
  latitude     Float
  longitude    Float
  speedKmh     Decimal? @map("speed_kmh") @db.Decimal(5, 2)
  heading      Decimal? @db.Decimal(5, 2)
  accuracyM    Decimal? @map("accuracy_m") @db.Decimal(6, 2)
  ignitionOn   Boolean? @map("ignition_on")
  networkState String?  @map("network_state")
  deviceTime   DateTime @map("device_time")
  receivedAt   DateTime @default(now()) @map("received_at")

  school School    @relation(fields: [schoolId], references: [id])
  bus    Bus       @relation(fields: [busId], references: [id])
  device BusDevice @relation(fields: [deviceId], references: [id])
  trip   Trip?     @relation(fields: [tripId], references: [id])

  @@unique([deviceId, deviceTime])
  @@index([busId, deviceTime(sort: Desc)])
  @@index([tripId])
  @@index([schoolId, deviceTime(sort: Desc)])
  @@map("gps_points")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

// The durable, logical notification record (Phase 1 Step 9) — one row per
// (event, recipient), independent of how many channels it's delivered
// through (see NotificationDelivery below). `title`/`body` are
// pre-rendered plain text from a centralized template
// (NotificationTemplates, apps/api/src/notifications/) at creation time —
// never raw client input, never assembled ad hoc at read time, so
// localization can be added later in one place. `payload` is a small,
// non-sensitive structured pointer (e.g. `{tripId}`) for the frontend to
// link back to the relevant screen — never raw GPS coordinates, device
// ids, or other internal identifiers beyond what's already in `entityId`.
//
// `@@unique([schoolId, eventType, entityId, recipientType, recipientId])`
// is the idempotency key: reprocessing the same domain event for the same
// recipient is a silent no-op (caught the same way GPS telemetry's retry
// dedup works — see docs/adr/0014), never a duplicate row. `entityId` is
// chosen per event type to make this constraint mean exactly "one
// notification per real-world occurrence": the originating
// AttendanceEvent's own id for CHILD_BOARDED/CHILD_DROPPED_OFF (each
// boarding/drop-off is already a unique immutable fact — see ADR 0013), the
// Trip's id for TRIP_CANCELLED/TRIP_NO_SHOW (a trip can only reach that
// terminal status once), and the Trip's id for GPS_STALE/GPS_OFFLINE too
// (at most one alert per trip per transition type, not one per stale
// reading — see docs/adr/0016-notifications-and-alerts.md).
model Notification {
  id            String                @id @default(uuid())
  schoolId      String                @map("school_id")
  recipientType RecipientType         @map("recipient_type")
  recipientId   String                @map("recipient_id")
  eventType     NotificationEventType @map("event_type")
  entityType    String                @map("entity_type")
  entityId      String                @map("entity_id")
  title         String
  body          String
  payload       Json?
  readAt        DateTime?             @map("read_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  school     School                 @relation(fields: [schoolId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([schoolId, eventType, entityId, recipientType, recipientId])
  @@index([schoolId, recipientType, recipientId, createdAt(sort: Desc)])
  @@index([schoolId, recipientType, recipientId, readAt])
  @@map("notifications")
}

// Per-channel delivery tracking — deliberately split from Notification
// (the "logical" record) rather than one row per channel, so "was this
// actually sent" is never confused with "does this notification exist."
// `schoolId` is denormalized here (not just reachable via `notification`)
// to match this codebase's standing RLS convention — every tenant-scoped
// table carries its own school_id column, never relies on a join for
// row-level security. See docs/database.md#5-row-level-security.
model NotificationDelivery {
  id                String                     @id @default(uuid())
  schoolId          String                     @map("school_id")
  notificationId    String                     @map("notification_id")
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @map("provider_message_id")
  attempts          Int                        @default(0)
  lastAttemptAt     DateTime?                  @map("last_attempt_at")
  deliveredAt       DateTime?                  @map("delivered_at")
  failedAt          DateTime?                  @map("failed_at")
  failureReason     String?                    @map("failure_reason")
  createdAt         DateTime                   @default(now()) @map("created_at")

  school       School       @relation(fields: [schoolId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

// Per-parent, per-channel opt-out (Phase 1 Step 9). Deliberately simpler
// than the Phase 0 scaffold's per-(parent, eventType, channel) shape — the
// spec's actual minimum is a flat per-channel toggle, and a full matrix
// nobody asked for would be exactly the over-engineering this phase's
// instructions warn against. Covers PUSH/SMS/EMAIL only: IN_APP delivery
// is unconditional for every notification-producing event and is never
// represented here at all, so there is no row to flip that could
// accidentally suppress a required operational notification — see
// docs/adr/0016-notifications-and-alerts.md. `schoolId` was added here
// (the Phase 0 scaffold had none) while wiring this up for real, matching
// the standing RLS convention.
model NotificationPreference {
  id       String              @id @default(uuid())
  schoolId String              @map("school_id")
  parentId String              @map("parent_id")
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  @@unique([parentId, channel])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(uuid())
  schoolId    String?   @map("school_id")
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id")
  action      String
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  requestId   String?   @map("request_id")
  ipAddress   String?   @map("ip_address")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id                 String    @id @default(uuid())
  schoolId           String    @map("school_id")
  ownerType          String    @map("owner_type")
  ownerId            String?   @map("owner_id")
  storageKey         String    @map("storage_key")
  contentType        String    @map("content_type")
  sizeBytes          BigInt?   @map("size_bytes")
  retentionExpiresAt DateTime? @map("retention_expires_at")
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  school         School    @relation(fields: [schoolId], references: [id])
  creator        User?     @relation("FileCreatedBy", fields: [createdBy], references: [id])
  studentPhotoOf Student[] @relation("StudentPhoto")

  @@map("files")
}

// ---------------------------------------------------------------------------
// Authentication / Sessions
//
// principalType/principalId are polymorphic (User or Parent) — same
// established pattern as audit_logs.actor_id/files.owner_id (see this
// schema's header comment); no Prisma relation, integrity enforced at the
// service layer.
//
// IMPORTANT: looking a token up BY ITS HASH necessarily happens before the
// caller's tenant is known (that is what the lookup is for), so it cannot go
// through the normal RLS-scoped path — it uses PrismaService's
// runAsPlatformAdmin() escape hatch, narrowly, on a unique-hash-only WHERE
// clause. Every other operation on these tables (rotation, revocation,
// listing) runs through the normal tenant-scoped path once the schoolId is
// known. See docs/adr/0010-credential-resolution-rls-bypass.md.
// ---------------------------------------------------------------------------

model RefreshToken {
  id                String             @id @default(uuid())
  schoolId          String             @map("school_id")
  principalType     AuthPrincipalType  @map("principal_type")
  principalId       String             @map("principal_id")
  sessionId         String             @map("session_id")
  tokenHash         String             @unique @map("token_hash")
  issuedAt          DateTime           @default(now()) @map("issued_at")
  expiresAt         DateTime           @map("expires_at")
  revokedAt         DateTime?          @map("revoked_at")
  revokedReason     TokenRevokeReason? @map("revoked_reason")
  replacedByTokenId String?            @unique @map("replaced_by_token_id")
  userAgent         String?            @map("user_agent")
  ipAddress         String?            @map("ip_address")
  createdAt         DateTime           @default(now()) @map("created_at")

  school       School        @relation(fields: [schoolId], references: [id])
  replacedBy   RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id])
  replacedFrom RefreshToken? @relation("RefreshTokenReplacement")

  @@index([schoolId])
  @@index([principalType, principalId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id            String            @id @default(uuid())
  schoolId      String            @map("school_id")
  principalType AuthPrincipalType @map("principal_type")
  principalId   String            @map("principal_id")
  tokenHash     String            @unique @map("token_hash")
  expiresAt     DateTime          @map("expires_at")
  usedAt        DateTime?         @map("used_at")
  requestedIp   String?           @map("requested_ip")
  createdAt     DateTime          @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([principalType, principalId])
  @@map("password_reset_tokens")
}

// Staff (User) or parent (Parent) onboarding — the person is created up front
// in status INVITED with no password (see User.passwordHash /
// Parent.passwordHash), and this record tracks the single-use, time-limited
// token that lets them set one and become ACTIVE. Same polymorphic
// principalType/principalId shape as RefreshToken/PasswordResetToken, and
// the same pre-tenant lookup-by-hash concern: the invitee isn't
// authenticated yet when they open their invite link, so
// InvitationsService looks it up via PrismaService.runAsPlatformAdmin() —
// this table therefore also needs the platform-admin RLS bypass clause (see
// docs/adr/0010-credential-resolution-rls-bypass.md and
// docs/database.md#5-row-level-security).
model Invitation {
  id            String            @id @default(uuid())
  schoolId      String            @map("school_id")
  principalType AuthPrincipalType @map("principal_type")
  principalId   String            @map("principal_id")
  tokenHash     String            @unique @map("token_hash")
  invitedBy     String            @map("invited_by")
  expiresAt     DateTime          @map("expires_at")
  acceptedAt    DateTime?         @map("accepted_at")
  revokedAt     DateTime?         @map("revoked_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  school  School @relation(fields: [schoolId], references: [id])
  inviter User   @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])

  // One live invitation per principal — re-inviting updates this row (fresh
  // token/expiry) rather than creating a second one.
  @@unique([principalType, principalId])
  @@index([schoolId])
  @@map("invitations")
}
