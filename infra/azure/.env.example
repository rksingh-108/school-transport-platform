# Azure deployment variables for infra/azure/deploy.sh.
#
# Copy to infra/azure/.env.deploy (git-ignored — add the filename to .gitignore)
# and fill in real values, then:
#
#   set -a; . ./infra/azure/.env.deploy; set +a
#   infra/azure/deploy.sh
#
# Run `pnpm db:migrate:deploy` (or `pnpm db:bootstrap`) against the
# DATABASE_URL below before the first deploy. These are variable NAMES with
# placeholder values — never commit the filled-in .env.deploy file.

# --- Azure targeting ---
RG=school-transport-rg
LOC=eastasia
ACR_NAME=schooltransportacr108
ACR_REGISTRY=schooltransportacr108.azurecr.io
CONTAINER_ENV_NAME=school-transport-env

# --- PostgreSQL (flexible server; the API connects as APP_DB_USER) ---
PG_SERVER=school-transport-pg108
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me
# DB_NAME=school_transport

# --- Azure Managed Redis (REDIS_PASSWORD is the cluster access key) ---
REDIS_HOST=school-transport-redis108.eastasia.redis.azure.net
REDIS_PASSWORD=change-me

# --- MinIO object store credentials (also the API's STORAGE_* keys) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
# STORAGE_BUCKET=school-transport-prod

# --- JWT secrets: distinct per audience, >= 32 characters ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_STAFF_SECRET=change-me
JWT_PARENT_SECRET=change-me

# --- Optional ---
# IMAGE_TAG=             # defaults to a UTC timestamp
# API_IMAGE_TAG=         # defaults to IMAGE_TAG
# WEB_IMAGE_TAG=         # defaults to IMAGE_TAG
# SKIP_BUILD=1           # roll out images that are already pushed
# RECREATE_API=1         # required when API credentials/env vars change (express env)
# RECREATE_WEB=1
# API_APP=school-transport-api
# WEB_APP=school-transport-web
# MINIO_APP=school-transport-minio

# --- First-run bootstrap (prisma/bootstrap.ts), only when seeding RBAC ---
# BOOTSTRAP_ADMIN_EMAIL=platform.admin@example.com
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# BOOTSTRAP_SCHOOL_NAME=Example School
# BOOTSTRAP_SCHOOL_SLUG=example-school
# BOOTSTRAP_SCHOOL_ADMIN_EMAIL=school.admin@example.com
# BOOTSTRAP_SCHOOL_ADMIN_NAME=School Administrator
# BOOTSTRAP_SCHOOL_ADMIN_PASSWORD=change-me
