# Copy to .env and fill in real values for your environment.
# .env is git-ignored — never commit real secrets. Values below are safe,
# obviously-fake local-development defaults, not production secrets.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (see docs/database.md, docs/adr/0002-multi-tenancy-strategy.md)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=school_transport
# Non-default host port: many dev machines already run a native Postgres
# service (5432) or other Dockerized Postgres instances (5433) alongside this
# project. 5434 avoids the collisions observed in this repo's own dev setup —
# change if it's also taken on yours.
POSTGRES_PORT=5434

# Restricted role the API connects as at runtime — subject to Row-Level Security
# (docs/database.md#5-row-level-security). Created automatically by
# infra/docker/postgres/init/01-create-app-role.sh on first container start.
APP_DB_USER=app_user
APP_DB_PASSWORD=dev_only_change_me_too

# Privileged connection used ONLY by the Prisma CLI (migrate/seed) — never by
# the running API. Composed from the POSTGRES_* values above for local dev.
DATABASE_URL="postgresql://postgres:dev_only_change_me@localhost:5434/school_transport?schema=public"

# Restricted connection used by apps/api's PrismaService at runtime (app_user).
API_DATABASE_URL="postgresql://app_user:dev_only_change_me_too@localhost:5434/school_transport?schema=public"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=dev_only_change_me_redis
REDIS_URL="redis://:dev_only_change_me_redis@localhost:6379"

# ---------------------------------------------------------------------------
# Object storage (MinIO locally; any S3-compatible provider in production —
# see docs/adr/0007-map-and-storage-provider-abstraction.md)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev_only_change_me_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=school-transport-dev
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=dev_only_change_me_minio
STORAGE_BUCKET=school-transport-dev

# ---------------------------------------------------------------------------
# Authentication (see docs/security.md#1-authentication,
# docs/adr/0004-auth-strategy.md). Generate real secrets with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never reuse these example values outside local development.
# ---------------------------------------------------------------------------
JWT_STAFF_SECRET=dev_only_staff_secret_change_me_to_something_random_and_long
JWT_PARENT_SECRET=dev_only_parent_secret_change_me_to_something_random_and_long
JWT_ISSUER=school-transport-platform
JWT_STAFF_AUDIENCE=school-transport-staff
JWT_PARENT_AUDIENCE=school-transport-parent
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FAILED_LOGIN_MAX_ATTEMPTS=10
FAILED_LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# GPS telemetry / realtime tracking (see docs/adr/0014-gps-telemetry-and-realtime-tracking.md)
# ---------------------------------------------------------------------------
GPS_LIVE_THRESHOLD_SECONDS=90
GPS_STALE_THRESHOLD_SECONDS=300
GPS_MAX_FUTURE_SKEW_SECONDS=120
GPS_MAX_PAST_AGE_DAYS=7
GPS_TELEMETRY_RETENTION_DAYS=90
GPS_INGEST_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Socket.IO connects to the API's own origin (no /api/v1 prefix — the
# realtime gateway is a separate namespace, not a versioned REST route).
NEXT_PUBLIC_WS_BASE_URL=http://localhost:3001
